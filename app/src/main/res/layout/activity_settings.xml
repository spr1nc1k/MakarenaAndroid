<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/oled_black"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="WHITE SOLUTION ENGINE"
            android:textColor="@color/text_white"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Konfiguracja Silnika AI"
            android:textColor="@color/text_white"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Card: Gemini API Key -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Klucze Gemini API (Obsługa Rotacji)"
                android:textColor="@color/text_white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Wklej 1 lub kilka kluczy (oddzielonych przecinkiem lub spacją). Aplikacja automatycznie rotuje kluczami i modelami (Gemini 2.0 / 1.5)."
                android:textColor="@color/text_muted"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/edit_api_key"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_capsule"
                android:fontFamily="monospace"
                android:hint="@string/gemini_key_hint"
                android:inputType="text"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:textColor="@color/text_white"
                android:textColorHint="@color/text_muted"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_get_key"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Otwórz Google AI Studio i pobierz darmowy klucz"
                android:textColor="@color/text_white"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Card: Manual Panic Mode / Info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sterowanie Klawiszami Fizycznymi"
                android:textColor="@color/text_white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="• 2x głośność w dół: Natychmiastowy przełącznik WŁĄCZ / WYŁĄCZ (działa trwale między kolejnymi pytaniami).\n• 2x głośność w górę: Panic Mode (natychmiastowe ukrycie wszystkich śladów i blokada)."
                android:textColor="@color/text_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="26dp"
            android:backgroundTint="@color/text_white"
            android:text="ZAPISZ I WRÓĆ"
            android:textColor="@color/oled_black"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>
