<resources>
    <!-- Pure Monochrome Theme (Biel i Czerń) -->
    <style name="Theme.Makarena" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/text_white</item>
        <item name="colorSecondary">#888888</item>
        <item name="android:statusBarColor">@color/oled_black</item>
        <item name="android:navigationBarColor">@color/oled_black</item>
        <item name="android:windowBackground">@color/oled_black</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>

    <style name="Theme.Makarena.Splash" parent="Theme.MaterialComponents.NoActionBar">
        <item name="android:statusBarColor">@color/oled_black</item>
        <item name="android:navigationBarColor">@color/oled_black</item>
        <item name="android:windowBackground">@color/oled_black</item>
    </style>
</resources>
